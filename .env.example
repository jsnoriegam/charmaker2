SERVER_PORT=3002
# Bind por defecto solo localhost. Para LAN: SERVER_HOST=0.0.0.0 (sin auth).
#SERVER_HOST=0.0.0.0

SD_BINARY=/ruta/al/sd-cli
SD_MODEL_DIR=/ruta/a/los/checkpoints
SD_LORA_MODEL_DIR=/ruta/a/los/loras
SD_DEFAULT_MODEL=nombre_del_modelo.safetensors

# Timeout por generación en ms (default: 300000)
SD_TIMEOUT_MS=500000

# Imágenes anteriores que se conservan por base/variante al regenerar (default: 5)
#SD_HISTORY_KEEP=5

# rembg (quite de fondo): el binario se resuelve en este orden:
# REMBG_BIN -> .venv/bin/rembg del proyecto -> rembg en PATH
#REMBG_BIN=/ruta/al/rembg
REMBG_MODEL=birefnet-general

# VAE - usar VAE externo para evitar overflow fp16 (recomendado)
SD_VAE_PATH=/ruta/al/sdxl-vae-fp16-fix.safetensors
SD_VAE_TILING=1

# Rendimiento/VRAM (Vulkan)
SD_OFFLOAD_TO_CPU=1
SD_CACHE_MODE=ucache
SD_CACHE_OPTION=threshold=1.0

# ADetailer (reparación de manos/cara)
SD_AD_HAND_MODEL=/ruta/al/hand_yolov8s.safetensors
SD_AD_HAND_PROMPT=(perfect hands:1.10), (perfect hand anatomy:1.10), detailed fingers, five fingers
SD_AD_HAND_NEGATIVE_PROMPT=deformed hand, malformed hand, extra fingers, fused fingers, missing fingers, mutated hand, bad anatomy
SD_AD_HAND_EXTRA_ARGS=confidence=0.4,denoising_strength=0.2,inpaint_padding=48
SD_AD_FACE_MODEL=/ruta/al/face_yolov8n.safetensors
# Steps del 2º pase (adetailer de cara). Si se omite, usa los steps de la fila.
#SD_AD_FACE_STEPS=20

# Opcional: consistencia facial
#SD_PHOTOMAKER_PATH=/ruta/al/photomaker-v1.safetensors
#SD_IP_ADAPTER_PATH=/ruta/al/ip-adapter-plus-face_sdxl_vit-h.safetensors
#SD_CLIP_VISION_PATH=/ruta/al/CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors
